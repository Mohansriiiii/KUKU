GEMINI_API_KEY=your_ai_studio_key
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash

# To swap the chat model to any OpenAI-compatible API (OpenAI, Groq, OpenRouter, etc.):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_key
# CHAT_MODEL=gpt-4o-mini
# Search embeddings and voice transcription still use Gemini, so keep GEMINI_API_KEY.
